# Copy OUTSIDE the repository, chmod 600, then fill privately.
# Empty required values intentionally make Compose fail closed.
LIC_EMAIL=
LIC_CODE=
RSS_TOKEN=
# Must be reachable by the eventual reader and browser; not just the host.
# 127.0.0.1:18080 works for local validation, NOT for a Miniflux container.
RSS_HOST=
RSS_HTTPS=0
# Absolute, pre-created, private provider-only directory. Never a Reader DB.
WECHAT2RSS_DATA_DIR=
