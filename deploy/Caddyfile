    @legacy path /api/state /api/resolve /api/subscriptions* /api/refresh* /api/settings* /api/export /login /app.js /style.css /math-seg.js /source-group.js /vendor/* /index.html
    reverse_proxy @legacy 127.0.0.1:4322
    reverse_proxy 127.0.0.1:3062
  }
}
